# Feed News - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Feed News
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-random-string

# Database (SQLite default; for PostgreSQL: postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=sqlite+aiosqlite:///./feed_news.db
DATABASE_URL_SYNC=sqlite:///./feed_news.db

# Scheduler intervals
INGESTION_INTERVAL_MINUTES=15
PROCESSING_INTERVAL_MINUTES=5

# Translation provider: libre | openai | anthropic | none
TRANSLATION_PROVIDER=libre

# LibreTranslate (free public instances are used as fallback if no key)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# OpenAI (optional - enables better translation and summaries)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional - alternative LLM provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Admin API token (change this to a secure random value)
ADMIN_TOKEN=admin-token-change-me
